# Copy to .env (git-ignored) and fill in. `python -m sim simulate` and `python -m sim fetch-data`
# load it automatically; variables that are already set in the environment take precedence.

# Hugging Face token with access to the private AASB dataset (needed by `python -m sim fetch-data`).
HF_TOKEN=

# The variable name must match `api_key_env` of the model entry in the configuration.
OPENAI_API_KEY=
